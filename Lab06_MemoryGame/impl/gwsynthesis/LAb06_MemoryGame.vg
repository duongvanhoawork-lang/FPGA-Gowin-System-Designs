wire [1:0] \r_Pattern[8] ;
wire [1:0] \r_Pattern[9] ;
wire [1:0] \r_Pattern[10] ;
wire [2:0] r_SM_Main;
wire VCC;
wire GND;
  IBUF i_Clk_ibuf (
    .O(i_Clk_d),
    .I(i_Clk) 
);
  IBUF i_Switch_1_ibuf (
    .O(i_Switch_1_d),
    .I(i_Switch_1) 
);
  IBUF i_Switch_2_ibuf (
    .O(i_Switch_2_d),
    .I(i_Switch_2) 
);
  IBUF i_Switch_3_ibuf (
    .O(i_Switch_3_d),
    .I(i_Switch_3) 
);
  OBUF o_LED_1_obuf (
    .O(o_LED_1),
    .I(o_LED_1_d) 
);
  OBUF o_LED_2_obuf (
    .O(o_LED_2),
    .I(o_LED_2_d) 
);
  OBUF o_LED_3_obuf (
    .O(o_LED_3),
