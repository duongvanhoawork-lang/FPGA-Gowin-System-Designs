);
  INV w_Switch_3_s2 (
    .O(w_Switch_3_6),
    .I(w_Switch_3_Raw) 
);
  Debounce_Filter Debounce_SW1 (
    .i_Clk_d(i_Clk_d),
    .i_Switch_1_d(i_Switch_1_d),
    .w_Switch_1_Raw(w_Switch_1_Raw)
);
  Debounce_Filter_0 Debounce_SW2 (
    .i_Clk_d(i_Clk_d),
    .i_Switch_2_d(i_Switch_2_d),
    .w_Switch_2_Raw(w_Switch_2_Raw)
);
  Debounce_Filter_1 Debounce_SW3 (
    .i_Clk_d(i_Clk_d),
    .i_Switch_3_d(i_Switch_3_d),
    .w_Switch_3_Raw(w_Switch_3_Raw)
);
  State_Machine_Game Game_Inst (
    .i_Clk_d(i_Clk_d),
    .w_Switch_1_6(w_Switch_1_6),
    .w_Switch_2_6(w_Switch_2_6),
    .w_Switch_3_6(w_Switch_3_6),
    .w_Switch_1_Raw(w_Switch_1_Raw),
    .w_Switch_2_Raw(w_Switch_2_Raw),
    .w_Switch_3_Raw(w_Switch_3_Raw),
    .o_LED_1_d_5(o_LED_1_d_5),
    .o_LED_1_d_6(o_LED_1_d_6),
    .n50_34(n50_34),
    .n51_34(n51_34),
    .n105_28(n105_28),
    .w_Score(w_Score[3:0]),
    .r_Index(r_Index[3:0]),
    .\r_Pattern[8] (\r_Pattern[8] [1:0]),
    .\r_Pattern[9] (\r_Pattern[9] [1:0]),
    .\r_Pattern[10] (\r_Pattern[10] [1:0]),
    .r_SM_Main(r_SM_Main[2:0])
);
  Serial_7Segment_Driver Scoreboard (
    .i_Clk_d(i_Clk_d),
    .w_Score(w_Score[3:0]),
    .o_SEG7_RCLK_d(o_SEG7_RCLK_d),
    .o_SEG7_DIO_d(o_SEG7_DIO_d),
    .o_SEG7_SCLK_d(o_SEG7_SCLK_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
