module State_Machine_Project_Top (
  i_Clk,
  i_Switch_1,
  i_Switch_2,
  i_Switch_3,
  o_LED_1,
  o_LED_2,
  o_LED_3,
  o_SEG7_DIO,
  o_SEG7_SCLK,
  o_SEG7_RCLK
)
;
input i_Clk;
input i_Switch_1;
input i_Switch_2;
input i_Switch_3;
output o_LED_1;
output o_LED_2;
output o_LED_3;
output o_SEG7_DIO;
output o_SEG7_SCLK;
output o_SEG7_RCLK;
wire i_Clk_d;
wire i_Switch_1_d;
wire i_Switch_2_d;
wire i_Switch_3_d;
