);
  OBUF o_SEG7_RCLK_obuf (
    .O(o_SEG7_RCLK),
    .I(o_SEG7_RCLK_d) 
);
  LUT3 o_LED_1_d_s (
    .F(o_LED_1_d),
    .I0(o_LED_1_d_12),
    .I1(o_LED_1_d_5),
    .I2(w_Switch_1_Raw) 
);
defparam o_LED_1_d_s.INIT=8'h70;
  LUT2 o_LED_2_d_s (
    .F(o_LED_2_d),
    .I0(o_LED_2_d_4),
    .I1(w_Switch_2_Raw) 
);
defparam o_LED_2_d_s.INIT=4'h4;
  LUT3 o_LED_3_d_s (
